<!DOCTYPE html>
<html>
  <body style="margin:0;padding:24px;background:#f5f5f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#171717;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #e5e5e5;border-radius:8px;">
      <tr>
        <td style="padding:24px 24px 0;">
          @if(logoUrl)
            <img src="{{ logoUrl }}" alt="{{ siteName }}" style="max-height:40px;max-width:200px;display:block;" />
          @else
            <p style="margin:0;font-size:14px;font-weight:600;">{{ siteName }}</p>
          @end
        </td>
      </tr>
      <tr>
        <td style="padding:16px 24px;font-size:15px;line-height:1.6;">
          {{{ bodyHtml }}}
        </td>
      </tr>
      @if(button)
        <tr>
          <td style="padding:0 24px 24px;">
            <a href="{{ button.url }}" style="display:inline-block;padding:10px 16px;background:#171717;color:#ffffff;text-decoration:none;border-radius:6px;font-size:14px;">{{ button.label }}</a>
          </td>
        </tr>
      @end
      <tr>
        <td style="padding:16px 24px;border-top:1px solid #e5e5e5;font-size:12px;color:#737373;">
          {{ footer }}
        </td>
      </tr>
    </table>
  </body>
</html>
