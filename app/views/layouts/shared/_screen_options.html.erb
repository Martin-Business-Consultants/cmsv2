<%# locals: () %>
<%# WordPress's Screen Options tab, top right of a list screen: tick which
    columns show (screen_options_controller). It shows only where the page
    has a table with columns to choose from (.screen-options, admin.css). %>
<div class="screen-options flex flex-col items-end" data-controller="screen-options" data-screen-options-screen-value="<%= controller_path %>#<%= action_name %>">
  <button type="button" class="<%= ui(:button, :plain, :small, "screen-options__tab") %>" aria-expanded="false" aria-controls="screen_options_panel" hidden
          data-screen-options-target="tab" data-action="screen-options#toggle">
    Screen options
    <%= icon_tag "caret-down", class: "size-3" %>
  </button>
  <div class="<%= ui(:panel, "mt-2 self-stretch px-5 py-4") %>" id="screen_options_panel" hidden data-screen-options-target="panel">
    <fieldset>
      <legend class="text-sm font-medium text-gray-900">Columns</legend>
      <div class="mt-2 flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-700" data-screen-options-target="choices"></div>
    </fieldset>
  </div>
</div>
